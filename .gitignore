# dependencias y artefactos de build
node_modules/
bin/
obj/
dist/
build/

# secretos: NUNCA se versionan
.env
*.local

# basura del sistema operativo y del editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# notas personales de estudio (no son parte de la entrega)
defensa-*.md

# reportes de Playwright (se publican como artifact en CI, no se versionan)
playwright-report/
test-results/
blob-report/

# Terraform (TP8): el estado tiene contraseñas en texto plano y NUNCA se versiona.
# El .terraform.lock.hcl SÍ se commitea (fija versión y hashes de los providers).
*.tfstate
*.tfstate.*
.terraform/
*.tfvars
crash.log

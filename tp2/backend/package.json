{
  "name": "erp-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Backend del ERP mínimo — IngSoft3 UCC 2026",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage --coverage.reportsDirectory=${COVERAGE_DIR:-coverage}"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9",
    "supertest": "^7.0.0",
    "vitest": "^2.1.9"
  }
}
